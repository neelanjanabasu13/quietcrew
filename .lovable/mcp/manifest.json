              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "search": {
              "description": "Optional text to match against the company name or the manual work described.",
              "type": "string",
              "minLength": 2
            }
          }
        },
        "outputSchema": null
      },
      {
